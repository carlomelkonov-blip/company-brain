# Copy to .env and adjust. Never commit .env.

# Central "control" database: the list of customers (tenants). Holds no customer content.
CONTROL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cb_control

# Template for each customer's own database. {db} is replaced with the tenant database name.
TENANT_DATABASE_URL_TEMPLATE=postgres://postgres:postgres@localhost:5432/{db}

# Used when the request has no subdomain (for example plain "localhost"). Leave empty in production.
DEFAULT_TENANT=acme

# Long random string used to sign session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Dev-only sign-in (pick a person from the directory). Must be false in production.
ALLOW_DEV_LOGIN=true

# AI provider. Leave ANTHROPIC_API_KEY empty to run in offline mode (no AI calls; simpler answers).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

API_PORT=8787
