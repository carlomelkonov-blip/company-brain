{
  "name": "company-brain",
  "private": true,
  "version": "0.1.0",
  "description": "Company Brain: a permission-aware knowledge graph of your company's meetings, email and people.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:setup": "pnpm --filter @company-brain/api db:setup",
    "seed": "pnpm --filter @company-brain/api seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
